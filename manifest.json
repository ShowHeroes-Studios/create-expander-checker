{
  "name": "Create Expander Checker",
  "description": "This extension checks the proper implementation of the Create Analytics and other tracking in expanders. It also checks if all URL macros are properly resolved by Create.",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "css": [ "css/style.css" ],
      "js": ["scripts/ga-properties.js", "scripts/parent.js"],
      "matches": [
        "https://create.showheroes.com/*"
      ]
    },
    {
      "js": ["scripts/frame.js"],
      "matches": [
        "https://csc-cdn01.showheroes.com/storage/*",
        "https://csc-cdn01.showheroes.com/creatives/*"
      ],
      "all_frames": true
    }
  ]
}
